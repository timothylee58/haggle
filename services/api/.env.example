DATABASE_URL=postgresql+asyncpg://haggle:haggle@localhost:5432/haggle
REDIS_URL=redis://localhost:6379/0
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only: any other value fails at startup
PAYPAL_ENV=sandbox

# Where the web app lives. Used for CORS and as PayPal's return address. Set it for any hosted demo.
FRONTEND_URL=http://localhost:3000

# Real prices for the start form (https://trychannel3.com/developers). Blank hides the price check.
CHANNEL3_API_KEY=

# Public-demo guards (see docs/deploy.md). LLM_MATCHES_PER_DAY=0 turns Claude off.
RATE_LIMITS_ENABLED=true
MATCHES_PER_HOUR_PER_IP=30
LLM_MATCHES_PER_DAY=25
MARKET_CHECKS_PER_HOUR_PER_IP=60
